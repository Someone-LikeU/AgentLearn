{
  "skill_name": "local-semantic-search",
  "evals": [
    {
      "id": 1,
      "name": "basic-local-search",
      "prompt": "帮我在本地搜索关于报告的文件",
      "expected_output": "返回包含'报告'关键词的文件列表，包括文件路径、名称、大小、类型等信息",
      "files": [],
      "assertions": [
        {
          "name": "returns_json_structure",
          "description": "返回正确的JSON结构",
          "type": "json_schema",
          "schema": {
            "type": "object",
            "required": ["results", "total"],
            "properties": {
              "results": {"type": "array"},
              "total": {"type": "number"}
            }
          }
        },
        {
          "name": "contains_file_info",
          "description": "结果包含必要的文件信息字段",
          "type": "json_path",
          "path": "$.results[0]",
          "expected_fields": ["path", "name", "size", "mtime"]
        }
      ]
    },
    {
      "id": 2,
      "name": "semantic-search-with-content",
      "prompt": "在本地查找包含数据分析内容的文档",
      "expected_output": "通过语义理解找到与数据分析相关的文档，即使文件名不包含该关键词",
      "files": [],
      "assertions": [
        {
          "name": "semantic_matching",
          "description": "能够进行语义匹配而非仅关键词匹配",
          "type": "output_contains",
          "text": "results"
        },
        {
          "name": "includes_search_metadata",
          "description": "包含搜索元数据",
          "type": "json_path",
          "path": "$",
          "expected_fields": ["search_time_ms", "total"]
        }
      ]
    },
    {
      "id": 3,
      "name": "search-with-type-filter",
      "prompt": "帮我搜索本地的PDF文件",
      "expected_output": "返回PDF类型的文件列表",
      "files": [],
      "assertions": [
        {
          "name": "filters_by_type",
          "description": "结果应该主要是PDF文件",
          "type": "json_path",
          "path": "$.results[*].type",
          "expected_value": "pdf"
        }
      ]
    },
    {
      "id": 4,
      "name": "index-build-prompt",
      "prompt": "我想在本地Documents文件夹建立搜索索引",
      "expected_output": "引导用户运行indexer.py脚本构建索引",
      "files": [],
      "assertions": [
        {
          "name": "mentions_indexer",
          "description": "提及索引构建方法",
          "type": "output_contains",
          "text": "indexer"
        }
      ]
    }
  ]
}
