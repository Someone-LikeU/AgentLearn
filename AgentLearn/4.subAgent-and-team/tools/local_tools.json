      "name": "START_BACKGROUND_COMMAND",
      "description": "Start a long-running shell command in the background and return a service_id for later checks, output reads, and stop.",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "working_dir": {
            "type": "string",
            "description": "Working directory for this background command. Defaults to ./runtime_output under the Agent project directory."
          },
          "cwd": {
            "type": "string",
            "description": "Alias of working_dir."
          },
          "service_id": {
            "type": "string",
            "description": "Optional stable id. If omitted, the tool generates one."
          },
          "startup_wait_seconds": {
            "type": "number",
            "description": "Seconds to wait before returning initial status/output.",
            "default": 2,
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "command"
        ]
      }
    }
  },
