{
  "servers": {
    "exa": {
      "enabled": true,
      "transport": "streamable_http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      },
      "tool_prefix": "exa",
      "timeout_seconds": 10
    },
    "tavily": {
      "enabled": true,
      "transport": "streamable_http",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}",
      "tool_prefix": "tavily",
      "timeout_seconds": 10
    }
  }
}
